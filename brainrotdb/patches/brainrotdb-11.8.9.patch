+/**
+  Should the statement text be parsed with BrainrotDB names only?
+
+  Only statements that come from a client connection are parsed strictly.
+  Server internal parsing (bootstrap, --init-file, replication, views,
+  triggers, stored routines, generated columns ...) always understands
+  both the BrainrotDB names and the original names.
+*/
+bool brainrot_strict_parsing(THD *thd)
+{
+  return !opt_bootstrap &&
+         !thd->slave_thread &&
+         thd->system_thread == NON_SYSTEM_THREAD &&
+         !thd->variables.brainrot_legacy_keywords;
+}
