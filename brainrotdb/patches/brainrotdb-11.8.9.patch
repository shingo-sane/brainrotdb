+/*
+  BrainrotDB: the original SQL names of the keywords that were renamed.
+  When strict BrainrotDB parsing is active (statements sent by clients,
+  brainrot_legacy_keywords=OFF) these are not keywords any more.
+*/
+struct brainrot_legacy_kw { const char *old_name; const char *new_name; };
+static const brainrot_legacy_kw brainrot_legacy_keywords[]=
+{
+  {"CREATE", "CORTISOL"},
+  {"ALTER", "RIZZ"},
+  {"DROP", "DRIPPADROPPA"},
+  {"TRUNCATE", "UNC"},
+  {"RENAME", "TROLL"},
+  {"COMMENT", "PORK"},
+  {"INSERT", "YAP"},
+  {"UPDATE", "GLAZE"},
+  {"DELETE", "COOK"},
+  {"MERGE", "FANUM"},
+  {"SELECT", "SKIBIDI"},
+  {"FROM", "OG"},
+  {"WHERE", "WHIP"},
+  {"DISTINCT", "MOG"},
+  {"GROUP", "AURA FARM"},
+  {"HAVING", "CRAVING"},
+  {"LIMIT", "EDGE"},
+  {"OFFSET", "CUMSHOT"},
+  {"JOIN", "JOINT"},
+  {"UNION", "PHONK"},
+  {"AS", "ASS"},
+  {"IN", "LOCKEDIN"},
+  {"BETWEEN", "LOWKEY"},
+  {"LIKE", "WISHIWASLIKEU"},
+  {"NULL", "TUFF"},
+  {"EXISTS", "AMONGUS"},
+  {"OR", "LOW"},
+  {"AND", "FENT"},
+  {"AVG", "BASED"},
+  {"KEY", "DIH"},
+  {"UNIQUE", "UNIDIH"},
+  {"CHECK", "JACKY"},
+  {"DEFAULT", "NPC"},
+  {"INDEX", "INCEST"},
+  {"COUNT", "AURAFARM"},
+  {"SUM", "SON"},
+  {"MIN", "MINIMAN"},
+  {"MAX", "MAXXING"},
+  {"ORDER", "MOG BY"},
+  {NULL, NULL}
+};
+
+static const brainrot_legacy_kw *brainrot_find_legacy(const char *name)
+{
+  for (const brainrot_legacy_kw *kw= brainrot_legacy_keywords; kw->old_name;
+       kw++)
+    if (!strcmp(kw->old_name, name))
+      return kw;
+  return NULL;
+}
+
+
+/*
+  BrainrotDB: rewrite SQL text that the server generated (SHOW CREATE ...)
+  so that it uses the BrainrotDB keyword names. Quoted strings, quoted
+  identifiers and comments are left untouched.
+*/
+
+static bool brainrot_word_eq(const char *w, size_t len, const char *kw)
+{
+  size_t kwlen= strlen(kw);
+  return len == kwlen &&
+         !my_strnncoll(&my_charset_latin1, (const uchar*) w, len,
+                       (const uchar*) kw, len);
+}
+
+static void brainrot_append_cased(String *out, const char *src, size_t srclen,
+                                  const char *name)
+{
+  bool lower= srclen && my_islower(&my_charset_latin1, src[0]);
+  for (const char *n= name; *n; n++)
+  {
+    char c= *n;
+    if (lower)
+      c= (char) my_tolower(&my_charset_latin1, c);
+    out->append(c);
+  }
+}
+
+static inline bool brainrot_ident_char(char c)
+{
+  return my_isalnum(&my_charset_latin1, c) || c == '_' || c == '$' ||
+         (uchar) c >= 0x80;
+}
+
+void brainrot_translate_sql(String *str)
+{
+  const char *p= str->ptr(), *end= p + str->length();
+  String out;
+  if (out.alloc(str->length() + str->length() / 4 + 16))
+    return;
+  out.set_charset(str->charset());
+  const char *prev_word= NULL;            // last word we copied
+  size_t prev_word_len= 0;
+  char prev_sig= 0;                       // last non-space char copied
+
+  while (p < end)
+  {
+    char c= *p;
+    if (c == '\'' || c == '"' || c == '`')
+    {
+      /* quoted string or identifier: copy as is */
+      const char *q= p + 1;
+      while (q < end)
+      {
+        if (*q == '\\' && c != '`' && q + 1 < end)
+          q+= 2;
+        else if (*q == c)
+        {
+          if (q + 1 < end && q[1] == c)   // doubled quote
+            q+= 2;
+          else
+            break;
+        }
+        else
+          q++;
+      }
+      if (q < end)
+        q++;
+      out.append(p, (uint32) (q - p));
+      p= q;
+      prev_sig= c;
+      prev_word= NULL;
+      continue;
+    }
+    if (c == '/' && p + 1 < end && p[1] == '*' &&
+        !(p + 2 < end && (p[2] == '!' || p[2] == 'M')))
+    {
+      const char *q= p + 2;
+      while (q + 1 < end && !(q[0] == '*' && q[1] == '/'))
+        q++;
+      q= (q + 1 < end) ? q + 2 : end;
+      out.append(p, (uint32) (q - p));
+      p= q;
+      continue;
+    }
+    if (my_isdigit(&my_charset_latin1, c))
+    {
+      const char *q= p;
+      while (q < end && brainrot_ident_char(*q))
+        q++;
+      out.append(p, (uint32) (q - p));
+      p= q;
+      prev_sig= '0';
+      prev_word= NULL;
+      continue;
+    }
+    if (!brainrot_ident_char(c))
+    {
+      out.append(c);
+      if (!my_isspace(&my_charset_latin1, c))
+        prev_sig= c;
+      p++;
+      continue;
+    }
+
+    /* a word */
+    const char *w= p;
+    while (p < end && brainrot_ident_char(*p))
+      p++;
+    size_t len= p - w;
+
+    /* next significant character / next word */
+    const char *n= p;
+    while (n < end && my_isspace(&my_charset_latin1, *n))
+      n++;
+    const char *nw= n;
+    while (nw < end && brainrot_ident_char(*nw))
+      nw++;
+    bool next_is_paren= n < end && *n == '(';
+    bool next_is_by= brainrot_word_eq(n, nw - n, "BY");
+
+    const char *repl= NULL;
+
+    if (prev_sig == '.' || prev_sig == '@')
+      repl= NULL;                         // db.name, @@variable
+    else if (prev_sig == '=' && prev_word &&
+             brainrot_word_eq(prev_word, prev_word_len, "ENGINE"))
+      repl= NULL;                         // ENGINE=MERGE stays an engine name
+    else if (brainrot_word_eq(w, len, "GROUP") && next_is_by)
+    {
+      brainrot_append_cased(&out, w, len, "AURA");
+      out.append(p, (uint32) (n - p));    // keep the white space
+      brainrot_append_cased(&out, n, nw - n, "FARM");
+      p= nw;
+      prev_sig= 'Y';
+      prev_word= NULL;
+      continue;
+    }
+    else if (brainrot_word_eq(w, len, "ORDER"))
+      repl= next_is_by ? "MOG" : NULL;
+    else if (brainrot_word_eq(w, len, "COUNT") ||
+             brainrot_word_eq(w, len, "SUM") ||
+             brainrot_word_eq(w, len, "MIN") ||
+             brainrot_word_eq(w, len, "MAX") ||
+             brainrot_word_eq(w, len, "AVG"))
+    {
+      if (next_is_paren)
+        for (const brainrot_legacy_kw *kw= brainrot_legacy_keywords;
+             kw->old_name; kw++)
+          if (brainrot_word_eq(w, len, kw->old_name))
+            repl= kw->new_name;
+    }
+    else
+    {
+      for (const brainrot_legacy_kw *kw= brainrot_legacy_keywords;
+           kw->old_name; kw++)
+        if (brainrot_word_eq(w, len, kw->old_name) && !strchr(kw->new_name, ' '))
+        {
+          repl= kw->new_name;
+          break;
+        }
+    }
+
+    if (repl)
+      brainrot_append_cased(&out, w, len, repl);
+    else
+      out.append(w, (uint32) len);
+    prev_word= w;
+    prev_word_len= len;
+    prev_sig= 'a';
+  }
+  str->length(0);
+  str->append(out);
+}
