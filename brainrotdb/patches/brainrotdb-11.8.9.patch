+/*
+  Peek (without consuming anything) whether the next word in the query
+  text is BY (or FARM, the BrainrotDB alias of BY).
+*/
+bool Lex_input_stream::brainrot_next_word_is_by() const
+{
+  const char *p= m_ptr, *end= m_end_of_query;
+  for (;;)
+  {
+    while (p < end && my_isspace(&my_charset_latin1, *p))
+      p++;
+    if (p + 1 < end && p[0] == '/' && p[1] == '*' &&
+        (p + 2 >= end || (p[2] != '!' && p[2] != 'M')))
+    {
+      const char *c= p + 2;
+      while (c + 1 < end && !(c[0] == '*' && c[1] == '/'))
+        c++;
+      if (c + 1 >= end)
+        return false;
+      p= c + 2;
+      continue;
+    }
+    break;
+  }
+  const char *w= p;
+  while (p < end && (my_isalnum(&my_charset_latin1, *p) || *p == '_' ||
+                     *p == '$'))
+    p++;
+  size_t len= p - w;
+  return (len == 2 && !my_strnncoll(&my_charset_latin1, (const uchar*) w, 2,
+                                    (const uchar*) "BY", 2)) ||
+         (len == 4 && !my_strnncoll(&my_charset_latin1, (const uchar*) w, 4,
+                                    (const uchar*) "FARM", 4));
+}
+
+bool Lex_input_stream::brainrot_is_mog(const Lex_ident_cli_st *kwd) const
+{
+  return kwd->length == 3 &&
+         !my_strnncoll(&my_charset_latin1, (const uchar*) kwd->str, 3,
+                       (const uchar*) "MOG", 3);
+}
